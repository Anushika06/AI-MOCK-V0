{
  "name": "ai-mock-exam-engine",
  "version": "1.0.0",
  "description": "Super TET mock tests: question-bank generation with Gemini, timed exam, results and practice",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc --project tsconfig.json",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "tsx src/db/migrate.ts && tsx src/db/seed.ts && tsx src/db/seed-bank.ts",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "tsx tests/run-all.ts",
    "test:unit": "tsx tests/verify-unit.ts",
    "gemini:smoke": "tsx tests/gemini-smoke.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "bank:seed": "tsx src/db/seed-bank.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anushika06/AI-Mock-Exam-Engine.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Anushika06/AI-Mock-Exam-Engine/issues"
  },
  "homepage": "https://github.com/Anushika06/AI-Mock-Exam-Engine#readme",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^8.3.0",
    "@google/genai": "^2.23.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "~5.7.0"
  }
}
