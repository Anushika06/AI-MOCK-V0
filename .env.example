# ─────────────────────────────────────────────
#  Super TET Mock Exam Engine — Environment Config
#  Copy to .env and fill in the values marked REPLACE.
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL connection (used by the app)
DATABASE_URL=postgresql://supertet:supertet_dev@localhost:5434/supertet_db
# Tests run against a SEPARATE database (they delete data). Defaults to
# DATABASE_URL with "_test" appended to the database name.
# TEST_DATABASE_URL=postgresql://supertet:supertet_dev@localhost:5434/supertet_db_test

# ─── Question generation ───
# LLM_PROVIDER:
#   gemini — real questions (needs GEMINI_API_KEY)
#   demo   — no key; placeholder questions, for trying the app end to end
#   fake   — fixed output used by automated tests
LLM_PROVIDER=demo
# Gemini model id — see https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.8-flash
# REPLACE: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional thinking level: minimal | low | medium | high (unset = model default)
LLM_THINKING_LEVEL=
LLM_MAX_OUTPUT_TOKENS=32768
# Question-authoring specification sent with every request (edit it freely; no restart needed)
PROMPT_SPEC_PATH=prompt.md

# ─── Question bank ───
# The bank is pre-filled from seed_questions/super_tet_seed.json (npm run bank:seed).
# Fresh questions per 120-question mock (~15%); everything else comes from the bank.
GENERATION_NEW_PER_MOCK=18
# Hard ceiling on fresh questions per mock when the bank runs short for a subject.
GENERATION_MAX_NEW_PER_MOCK=30
# Questions per Gemini request (18 fresh = 2 requests).
GENERATION_BATCH_SIZE=15
# Hard cap on Gemini requests per mock, retries and the repair pass included.
GENERATION_MAX_CALLS_PER_MOCK=4

# ─── Gemini request limits ───
LLM_REQUEST_TIMEOUT_MS=180000
# Retries per request on per-minute 429 / 5xx / timeouts. Daily-quota 429s are never retried.
LLM_RATE_LIMIT_MAX_RETRIES=2
# Minimum gap between request starts (6000 ms ≈ 10 requests/minute) and max in flight.
LLM_MIN_REQUEST_INTERVAL_MS=6000
LLM_MAX_CONCURRENCY=2

# ─── Background generation worker ───
GENERATION_WORKER_ENABLED=true
GENERATION_POLL_INTERVAL_MS=3000
GENERATION_HEARTBEAT_INTERVAL_MS=15000
# A running job without a heartbeat for this long is treated as interrupted and resumed
GENERATION_STALE_AFTER_SECONDS=120
MAX_CONCURRENT_GENERATIONS_PER_USER=2

# ─── Exam attempts ───
# How often expired attempts are auto-submitted in the background
ATTEMPT_SWEEP_INTERVAL_MS=30000

# ─── Docker Compose postgres service (used by docker-compose.yml) ───
POSTGRES_USER=supertet
POSTGRES_PASSWORD=supertet_dev
POSTGRES_DB=supertet_db
POSTGRES_PORT=5434
